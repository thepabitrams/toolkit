---
// src/tools/personalisation/wallpaper/About.astro
import { AccordionCard } from '@/core/components/ui';
---

<div class="flex flex-col gap-2">
  
  <AccordionCard title="How to use this tool" defaultOpen={true} client:load>
    <div class="flex flex-col gap-4 mt-2">
      <div class="flex gap-4">
        <div class="shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold mt-1">1</div>
        <div>
          <h4 class="font-semibold text-slate-900 dark:text-white text-sm mb-1">Pick a Color</h4>
          <p class="text-slate-500 text-sm">Select a color using the picker, or type a specific Hex code.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold mt-1">2</div>
        <div>
          <h4 class="font-semibold text-slate-900 dark:text-white text-sm mb-1">Choose Dimensions</h4>
          <p class="text-slate-500 text-sm">Pick a preset size for your device, or enter custom dimensions.</p>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="shrink-0 w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold mt-1">3</div>
        <div>
          <h4 class="font-semibold text-slate-900 dark:text-white text-sm mb-1">Generate & Download</h4>
          <p class="text-slate-500 text-sm">Select your file format and click "Generate Wallpaper" to download your solid color image.</p>
        </div>
      </div>
    </div>
  </AccordionCard>

  <AccordionCard title="Project Overview" client:load>
    <p class="mb-4">
      Wallpaper Generator is a fully client-side utility that creates solid color wallpapers for any device. It requires zero uploads and runs entirely in your browser.
    </p>
    <p>
      Perfect for matching your phone or desktop to a specific color scheme without needing Photoshop or complex design software.
    </p>
  </AccordionCard>

  <AccordionCard title="Under the hood (Architecture)" client:load>
    <p class="mb-4">
      This tool leverages a modern, lightweight architecture optimized for performance:
    </p>
    <ul class="list-disc pl-5 space-y-2 mb-4 text-sm">
      <li><strong class="text-slate-900 dark:text-white">Framework:</strong> Astro & React.</li>
      <li><strong class="text-slate-900 dark:text-white">Image Processing:</strong> HTML5 Canvas API for pixel-perfect solid color generation.</li>
      <li><strong class="text-slate-900 dark:text-white">Storage:</strong> Zustand for high-performance state management.</li>
    </ul>
    <p>
      Zero backend. Zero API keys. Just pure, local computation.
    </p>
  </AccordionCard>

</div>