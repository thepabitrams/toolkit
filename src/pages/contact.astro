---
// src/pages/contact.astro
import { HomeLayout } from '@/layouts';
import { site, social } from '@/config/site';

const title = 'Support & Contact - Toolkit';
const description = 'Get support for Toolkit tools. Report bugs, request features, or ask questions directly to the developer.';

const contactTemplates = [
  {
    id: 'bug',
    label: 'Bug Report',
    description: 'Something is broken, lagging, or not working as expected.',
    content: `[BUG] Brief description of the issue

Severity: [Critical / High / Medium / Low]

What happened:

Steps to reproduce (if applicable):
1. 
2. 

Expected behavior:

Device / Browser (e.g., iPhone 15 Safari, Windows 11 Chrome):`
  },
  {
    id: 'feature',
    label: 'Request a Feature or Tool',
    description: 'An idea to improve an existing tool, or a request for a brand new one.',
    content: `[FEATURE] Brief description of your idea

Target Tool (or "New Tool"):

What problem does this solve?:

What should it do?:

Why would this be useful?:`
  },
  {
    id: 'security',
    label: 'Security & Privacy',
    description: 'Report a potential vulnerability, data leak, or privacy concern.',
    content: `[SECURITY] Brief description of the vulnerability

Affected Tool / Page:

Steps to reproduce:

Impact (What data is exposed?):

Have you publicly disclosed this? [Yes / No]:

Your preferred contact method (Email / X DM):`
  }
];
---

<HomeLayout 
  title={title} 
  description={description} 
  canonicalPath="/contact"
>
  <div class="w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <header class="space-y-4 mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 tracking-tight">
        Support & Contact
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
        Toolkit is built and maintained by {site.author}. Pick a template
        below, copy it, fill in the details, and email it to support. 
        The prefix in the subject line (e.g., [BUG]) helps me sort and reply faster.
      </p>
    </header>

    <section class="space-y-6 mb-16">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
        Message Templates
      </h2>

      <div class="grid grid-cols-1 gap-5">
        {contactTemplates.map((template) => (
          <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden shadow-sm">
            
            <!-- 🔥 OLD LAYOUT: Title/Desc Left, Button Right -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 border-b border-gray-100 dark:border-gray-800">
              <div class="space-y-1">
                <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">
                  {template.label}
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {template.description}
                </p>
              </div>
              
              <button 
                class="copy-btn shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors w-full sm:w-auto"
                data-copy-target={`content-${template.id}`}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span class="btn-text">Copy</span>
              </button>
            </div>

            <!-- 🔥 OLD LAYOUT: Clean Light Text Block -->
            <pre 
              id={`content-${template.id}`}
              class="p-5 text-xs sm:text-sm font-mono text-gray-700 dark:text-gray-300 whitespace-pre-wrap wrap-break-word leading-relaxed bg-gray-50/50 dark:bg-gray-800/20"
            >{template.content}</pre>

          </div>
        ))}
      </div>
    </section>

    <section class="space-y-6">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
        Where to send
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Email Support -->
        <a
          href={`mailto:${site.email}`}
          class="flex items-start gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-gray-300 dark:hover:border-gray-700 transition-colors group"
        >
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 shrink-0 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/30 group-hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </span>
          <div class="flex-1 min-w-0 space-y-1">
            <p class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 transition-colors">Email Support</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">For bugs, features, and private messages.</p>
          </div>
        </a>

        <!-- GitHub -->
        <a
          href={`${social.github}/toolkit/issues`}
          target="_blank"
          rel="noreferrer noopener"
          class="flex items-start gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-gray-300 dark:hover:border-gray-700 transition-colors group"
        >
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 shrink-0 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/30 group-hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          </span>
          <div class="flex-1 min-w-0 space-y-1">
            <p class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 transition-colors">GitHub Issues</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">Best for public bugs and feature requests.</p>
          </div>
        </a>

        <!-- X -->
        <a
          href={social.x}
          target="_blank"
          rel="noreferrer noopener"
          class="flex items-start gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-gray-300 dark:hover:border-gray-700 transition-colors group"
        >
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 shrink-0 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/30 group-hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          </span>
          <div class="flex-1 min-w-0 space-y-1">
            <p class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 transition-colors">X (Twitter)</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">Short messages and quick questions.</p>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href={social.linkedin}
          target="_blank"
          rel="noreferrer noopener"
          class="flex items-start gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:border-gray-300 dark:hover:border-gray-700 transition-colors group"
        >
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 shrink-0 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/30 group-hover:text-blue-600 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          </span>
          <div class="flex-1 min-w-0 space-y-1">
            <p class="text-base font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 transition-colors">LinkedIn</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">For work or collaboration.</p>
          </div>
        </a>
      </div>
    </section>
  </div>

  <script>
    type CopyTargetId = string;

    const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');

    function fallbackCopy(text: string): boolean {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.top = '-9999px';
      textArea.style.left = '-9999px';
      textArea.setAttribute('readonly', '');
      document.body.appendChild(textArea);
      textArea.select();
      textArea.setSelectionRange(0, textArea.value.length);
      try {
        const isSuccessful = document.execCommand('copy');
        document.body.removeChild(textArea);
        return isSuccessful;
      } catch (error) {
        document.body.removeChild(textArea);
        return false;
      }
    }

    async function copyToClipboard(text: string): Promise<boolean> {
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (error) {
          return fallbackCopy(text);
        }
      }
      return fallbackCopy(text);
    }

    copyButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        const targetId = button.getAttribute('data-copy-target') as CopyTargetId | null;
        if (!targetId) return;

        const targetElement = document.getElementById(targetId);
        if (!targetElement) return;

        const textToCopy = targetElement.textContent || '';
        const isSuccess = await copyToClipboard(textToCopy);

        if (isSuccess) {
          const textSpan = button.querySelector('.btn-text') as HTMLElement | null;
          const originalText = textSpan?.innerText || 'Copy';
          
          if (textSpan) textSpan.innerText = 'Copied!';
          
          button.classList.add('border-green-500', 'text-green-600', 'bg-green-50');
          button.classList.remove('border-gray-200', 'text-gray-700');
          
          window.setTimeout(() => {
            if (textSpan) textSpan.innerText = originalText;
            button.classList.remove('border-green-500', 'text-green-600', 'bg-green-50');
            button.classList.add('border-gray-200', 'text-gray-700');
          }, 2000);
        }
      });
    });
  </script>
</HomeLayout>