---
// src/pages/privacy.astro
import { HomeLayout } from '@/layouts';
import { site } from '@/config/site';

const title = 'Privacy Policy - Toolkit';
const description = 'How Toolkit collects, uses, and protects your information. 100% local processing for all media and finance tools.';

const LAST_UPDATED = 'November 4, 2026';

const privacyPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Privacy Policy — ${site.name}`,
  url: `${site.domain}/privacy`,
  description: `How ${site.name} collects, uses, and protects your information.`,
  publisher: {
    '@type': 'Person',
    name: site.author,
  },
};
---

<HomeLayout
  title={title}
  description={description}
  canonicalPath="/privacy"
>
  <script type="application/ld+json" set:html={JSON.stringify(privacyPageSchema)} />

  <main class="py-16 px-4 sm:px-6">
    <article class="max-w-3xl mx-auto space-y-12">

      <header class="space-y-5">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 leading-[1.1] tracking-tight">
          Privacy Policy
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-500">
          Last updated: {LAST_UPDATED}
        </p>
        <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
          This Privacy Policy explains how {site.name} collects, uses, and
          protects your information when you use the service. It also
          describes your rights over your data and how to exercise them.
        </p>
        <p class="text-base text-gray-600 dark:text-gray-400 leading-relaxed">
          {site.name} is operated by {site.author} from India. By using
          the service, you agree to the practices described in this
          policy.
        </p>
      </header>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          Consent Notice Summary
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            This summary is provided as a standalone notice under Rule 3 of
            India&apos;s Digital Personal Data Protection Rules, 2025. It is
            designed to be understood independently of the rest of this
            policy.
          </p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Personal data collected:
              </strong>{' '}
              Your name, email address, profile picture URL (only when you
              sign in with Google), and your IP address and browser user
              agent (stored with your session for security).
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Purpose:
              </strong>{' '}
              To authenticate your account, display your name next to
              comments, protect your account from unauthorized access, and
              respond to your support requests.
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Withdraw consent or exercise rights:
              </strong>{' '}
              Email{' '}
              <a
                href={`mailto:${site.email}`}
                class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
              >
                {site.email}
              </a>
              . I will respond within the timelines set out in this policy.
            </li>
          </ul>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          1. Who I am
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            {site.name} is a free, open-source collection of browser-based tools. The service is built
            and maintained by {site.author}, an individual developer based
            in India.
          </p>
          <p>
            For the purposes of the EU General Data Protection Regulation
            (GDPR) and India&apos;s Digital Personal Data Protection Act,
            2023 (DPDP Act), {site.author} is the data controller (Data
            Fiduciary) responsible for the personal data collected through
            the service.
          </p>
          <p>
            You can contact me at{' '}
            <a
              href={`mailto:${site.email}`}
              class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              {site.email}
            </a>
            .
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          2. Information I collect
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            I collect only the minimum information needed to operate the
            service.
          </p>

          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 pt-2">
            100% Local Processing (Media & Finance Tools)
          </h3>
          <p>
            All images, files, and financial data processed by the tools on this website (such as Crop, Adjust Size, and Bill Splitter) remain entirely on your device. <strong>I do not collect, see, or store your images or financial data on any server.</strong>
          </p>

          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 pt-2">
            Information you provide through Google Sign-In
          </h3>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>Your name (as provided by Google)</li>
            <li>Your email address</li>
            <li>Your profile picture URL (if available)</li>
          </ul>
          <p class="text-sm text-gray-500 dark:text-gray-500">
            This information is used solely to identify your account and display your name when you post a comment. You do not need to sign in to use the tools.
          </p>

          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 pt-2">
            Information collected automatically
          </h3>
          <p>
            When you sign in, the authentication system stores your IP
            address and browser user agent string alongside your session
            record. This is standard practice for session security and is
            used solely to detect suspicious sign-ins and protect your
            account. It is not used for analytics, advertising, or
            tracking.
          </p>

          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 pt-2">
            Information I do not collect
          </h3>
          <p>
            I do not collect analytics data, advertising identifiers,
            cross-site tracking data, or browsing history. I do not use
            cookies beyond those required to keep you signed in.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          3. Google User Data and Limited Use Disclosure
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            When you choose to sign in with Google, {site.name} requests
            access only to the basic{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">openid</strong>,{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">email</strong>, and{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">profile</strong>{' '}
            scopes. These scopes provide your name, email address, and
            profile picture URL. I do not request access to Gmail, Google
            Drive, Google Calendar, or any other Google service.
          </p>
          <p>
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              Limited Use Disclosure:
            </strong>{' '}
            {site.name}&apos;s use and transfer of information received from
            Google APIs to any other app will adhere to the{' '}
            <a
              href="https://developers.google.com/terms/api-services-user-data-policy"
              target="_blank"
              rel="noreferrer noopener"
              class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              Google API Services User Data Policy
            </a>
            , including the Limited Use requirements.
          </p>
          <p>
            I do not sell Google user data. I do not use Google user data
            for advertising, profiling, or training generalized AI models.
            I do not allow humans to read your Google user data unless you
            have given explicit consent for a specific support request, or
            unless required for security investigations or to comply with
            applicable law.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          4. How I use your information
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>I use the information I collect only to:</p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>Authenticate your account and keep you signed in</li>
            <li>Display your name and avatar next to comments you post</li>
            <li>Protect your account from unauthorized access</li>
            <li>Respond to your support requests</li>
          </ul>
          <p>
            I never sell your data. I never share it with advertisers. I
            never use it for any purpose other than operating the service.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          5. Legal basis for processing
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            Under the GDPR, I process your personal data on the following
            legal bases:
          </p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Consent
              </strong>{' '}
              — you give me permission to access your Google account
              information when you sign in. You can withdraw this consent
              at any time by requesting account deletion.
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Contractual necessity
              </strong>{' '}
              — processing is necessary to provide the service you
              requested (delivering comments and maintaining your session).
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Legitimate interest
              </strong>{' '}
              — I process minimal data to prevent abuse and maintain
              service security.
            </li>
          </ul>
          <p>
            Under India&apos;s DPDP Act, consent is the primary basis for
            processing personal data. You provide consent when you sign in
            with Google and use the service.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          6. Data retention
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              Tool Data
            </strong>{' '}
            (like your Bill Splitter groups and local preferences) is stored securely within your own browser using LocalStorage and IndexedDB. This data never reaches my servers and is automatically cleared if you clear your browser cache, or after 7 days of inactivity.
          </p>
          <p>
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              Comments
            </strong>{' '}
            are stored in the Cloudflare D1 database and are retained indefinitely unless you request their deletion.
          </p>
          <p>
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              Account information
            </strong>{' '}
            (name, email, profile picture) is retained as long as you have an active account. You can request deletion at any time by emailing me.
          </p>
          <p>
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              Session records
            </strong>{' '}
            (including IP address and user agent) are deleted when your
            session expires, or when you sign out.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          7. Third-party services
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            {site.name} relies on the following third-party services to
            operate:
          </p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Google
              </strong>{' '}
              — for authentication. When you sign in, Google shares your
              name, email, and profile picture with me. Your use of Google
              is governed by Google&apos;s Privacy Policy and the Google
              API Services User Data Policy.
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Cloudflare
              </strong>{' '}
              — for hosting, database storage (D1), and edge computing. Data is processed on
              Cloudflare&apos;s infrastructure. Cloudflare is a data
              processor under contract with me and does not have
              independent access to your data.
            </li>
          </ul>
          <p>
            I do not use any other third-party services for tracking,
            analytics, or advertising. I do not share your data with any
            other third party except as required by law.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          8. International data transfers
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            Your data may be stored and processed on servers located
            outside your country of residence, including servers operated
            by Cloudflare. When I transfer personal data outside the
            EU/EEA, I rely on appropriate safeguards such as Standard
            Contractual Clauses (SCCs) or equivalent mechanisms.
          </p>
          <p>
            Under India&apos;s DPDP Act, data transfers are permitted
            unless the government restricts transfers to specific
            countries by notification. I comply with all applicable
            restrictions.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          9. Your rights
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>Depending on your location, you have the right to:</p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Access
              </strong>{' '}
              — request a copy of the personal data I hold about you
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Correction
              </strong>{' '}
              — request correction of inaccurate or incomplete data
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Deletion
              </strong>{' '}
              — request deletion of your account and personal data
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Withdrawal of consent
              </strong>{' '}
              — withdraw your consent to data processing at any time
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Objection
              </strong>{' '}
              — object to processing based on legitimate interests
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Lodge a complaint with a supervisory authority
              </strong>{' '}
              — if you are located in the EU/EEA, you have the right to
              lodge a complaint with your local data protection authority
              at any time
            </li>
          </ul>
          <p>
            To exercise any of these rights, contact me at{' '}
            <a
              href={`mailto:${site.email}`}
              class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              {site.email}
            </a>
            . I will respond within 30 days (GDPR) or 45 days (CCPA) or 90
            days (DPDP Act), as applicable.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          10. Children&apos;s privacy
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            {site.name} is not intended for children under the age of 13.
            I do not knowingly collect personal information from children
            under 13.
          </p>
          <p>
            Under India&apos;s DPDP Act, I do not process the personal
            data of children without verifiable parental consent. If you
            believe a child has provided me with personal information,
            please contact me so I can delete it.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          11. Security
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            I take reasonable measures to protect your personal data from
            unauthorized access, alteration, or destruction. These
            measures include:
          </p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>Encryption of data in transit (HTTPS/TLS)</li>
            <li>Secure authentication via Google OAuth 2.0</li>
            <li>Edge-hosted infrastructure on Cloudflare</li>
            <li>Access controls on the database</li>
          </ul>
          <p>
            However, no method of transmission or storage is 100% secure.
            I cannot guarantee absolute security of your data.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          12. Changes to this policy
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            I may update this Privacy Policy from time to time. When I do,
            I will update the &ldquo;Last updated&rdquo; date at the top
            of this page. For material changes, I will provide notice
            through the service or by email.
          </p>
          <p>
            Your continued use of {site.name} after changes are posted
            means you accept the updated policy.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          13. Grievance redressal and complaints
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            If you have a complaint about how I handle your personal data,
            please contact my Grievance Officer first:
          </p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Grievance Officer / Data Protection Officer:
              </strong>{' '}
              {site.author}
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">
                Email:
              </strong>{' '}
              <a
                href={`mailto:${site.email}`}
                class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
              >
                {site.email}
              </a>
            </li>
          </ul>
          <p>
            For complaints relating to user-generated content (comments),
            my Grievance Officer will acknowledge your complaint within{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              24 hours
            </strong>{' '}
            and resolve it within{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              7 days
            </strong>
            , in line with the IT Rules, 2021 as amended in February 2026.
            For urgent complaints involving nudity, impersonation, or
            morphed content, resolution will be within{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              2 hours
            </strong>
            .
          </p>
          <p>
            For rights requests and general data protection grievances
            under the DPDP Act, I will respond within a reasonable period
            not exceeding{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              90 days
            </strong>
            .
          </p>
          <p>
            If your complaint is not resolved satisfactorily, you have the
            right to file a complaint with the{' '}
            <strong class="font-semibold text-gray-900 dark:text-gray-100">
              Data Protection Board of India
            </strong>{' '}
            through its official portal:{' '}
            <a
              href="https://dpboard.gov.in"
              target="_blank"
              rel="noreferrer noopener"
              class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              https://dpboard.gov.in
            </a>
            . If you are located in the EU/EEA, you also have the right to
            lodge a complaint with your local data protection supervisory
            authority.
          </p>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">
          14. Contact
        </h2>
        <div class="space-y-4 text-base text-gray-700 dark:text-gray-300 leading-relaxed">
          <p>
            For any questions about this Privacy Policy, how I handle your
            data, or to exercise your data rights, contact me at{' '}
            <a
              href={`mailto:${site.email}`}
              class="font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              {site.email}
            </a>
            .
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-500">
            Data controller: {site.author}, India
          </p>
        </div>
      </section>

      <footer class="pt-10 border-t border-gray-200 dark:border-gray-800">
        <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-base">
          <a
            href="/"
            class="inline-flex items-center gap-2 font-semibold text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors"
          >
            <span>{site.name}</span>
          </a>

          <span class="text-gray-400 dark:text-gray-500">·</span>

          <span class="text-gray-500 dark:text-gray-500">
            Built by
          </span>

          <a
            href="https://pabitramohansingh.com"
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex items-center gap-2 font-semibold text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors"
          >
            <span>{site.author}</span>
          </a>
        </div>
      </footer>

    </article>
  </main>
</HomeLayout>