---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolView from '../_pages/ToolView.tsx';
import { tools, getTool } from '../config/tools';

export async function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug } }));
}

const { slug } = Astro.params;
const tool = getTool(slug as string);

if (!tool) {
  return Astro.redirect('/404');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.seoTitle,
  description: tool.seoDescription,
  url: new URL(`/${tool.slug}`, Astro.site).toString(),
  author: { '@type': 'Person', name: 'Pabitra Mohan Singh' },
};
---
<BaseLayout title={tool.seoTitle} description={tool.seoDescription} canonicalPath={`/${tool.slug}`} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-extrabold tracking-tight mb-2">{tool.name}</h1>
    <p class="text-gray-500 mb-6">{tool.seoDescription}</p>
    <div class="my-8 rounded-2xl border border-gray-200 dark:border-gray-800 p-6 bg-slate-50 dark:bg-slate-900 shadow-sm">
      <ToolView slug={slug as string} client:only="react" />
    </div>
  </div>
</BaseLayout>