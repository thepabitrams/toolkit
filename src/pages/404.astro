---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not Found" description="Page not found" canonicalPath="/404">
  <div class="flex flex-col items-center justify-center min-h-[50vh]">
    <h1 class="text-4xl font-bold mb-4">404</h1>
    <p class="text-gray-500 mb-6">The page you are looking for does not exist.</p>
    <a href="/" class="text-blue-500 hover:underline">Go back home</a>
  </div>
</BaseLayout>