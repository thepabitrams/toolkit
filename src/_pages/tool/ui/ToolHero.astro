---
import type { ToolConfig } from '@/config/tools';

interface Props {
  tool: ToolConfig;
}

const { tool: activeToolConfig } = Astro.props;
---

<div class="mb-8">
  <h1 class="text-3xl font-extrabold tracking-tight text-black dark:text-white mb-2">
    {activeToolConfig.displayName}
  </h1>
  <p class="text-base text-gray-500 dark:text-gray-400 font-medium">
    {activeToolConfig.displayDescription}
  </p>
</div>