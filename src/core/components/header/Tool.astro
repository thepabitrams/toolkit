---
import ThemeToggle from '../../../shared/components/ThemeToggle.tsx';
---
<header class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 h-[64px] flex items-center justify-between">
    <div class="flex items-center gap-4">
      <button 
        id="tool-menu-btn"
        class="p-2 rounded-md hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors text-gray-700 dark:text-gray-300"
        aria-label="Open tool menu"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <a href="/" class="font-bold text-xl tracking-tight text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
        Toolkit
      </a>
    </div>
    <div class="flex items-center gap-4">
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('tool-menu-btn');
    const drawer = document.getElementById('tool-drawer');
    const overlay = document.getElementById('tool-drawer-overlay');

    if (btn && drawer && overlay) {
      btn.addEventListener('click', () => {
        drawer.classList.remove('-translate-x-full');
        overlay.classList.remove('hidden');
      });
    }
  });
</script>