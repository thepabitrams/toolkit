---
import { site } from '@/config/site';
import { Container } from '@/core/components/ui/Container';
import ThemeToggle from '@/core/components/ui/ThemeToggle';
---

<header class="sticky top-0 z-50 h-16 bg-gray-50 dark:bg-gray-950 flex items-center">
  <Container className="w-full flex items-center justify-between">
    
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 shrink-0" aria-hidden="true"></div>
      <a
        href="/"
        class="font-medium text-lg tracking-tight text-gray-800 dark:text-gray-100 hover:opacity-80 transition-opacity"
      >
        {site.name}
      </a>
    </div>

    <div class="flex items-center justify-end">
      <ThemeToggle client:load />
    </div>
    
  </Container>
</header>