---
import Container from '@/core/components/Container.astro';
import Avatar from '@/core/components/Avatar.astro';
import { site, social, sponsor } from '@/config/site';
import { FaGithub, FaLinkedin, FaXTwitter, FaInstagram, FaYoutube } from 'react-icons/fa6';
import { FiMail, FiHeart, FiExternalLink } from 'react-icons/fi';

const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'GitHub', url: social.github, icon: FaGithub, hoverColor: 'hover:text-black dark:hover:text-white' },
  { name: 'LinkedIn', url: social.linkedin, icon: FaLinkedin, hoverColor: 'hover:text-[#0A66C2]' },
  { name: 'X', url: social.x, icon: FaXTwitter, hoverColor: 'hover:text-black dark:hover:text-white' },
  { name: 'YouTube', url: social.youtube, icon: FaYoutube, hoverColor: 'hover:text-[#FF0000]' },
  { name: 'Instagram', url: social.instagram, icon: FaInstagram, hoverColor: 'hover:text-[#E1306C]' },
];
---
<footer class="mt-auto bg-white pt-16 pb-8 dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800">
  <Container>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-12">
      
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8">
        <div class="shrink-0">
          <Avatar />
        </div>
        
        <div class="flex flex-col items-center sm:items-start text-center sm:text-left gap-3">
          
          <h2 class="text-2xl font-bold tracking-tight">
            <a 
              href="https://pabitramohansingh.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group inline-flex items-center gap-1 text-gray-900 dark:text-white hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
            >
              {site.author}
              <!-- Changed size to 16 -->
              <FiExternalLink size={16} className="text-gray-400 group-hover:text-blue-500 transition-colors mb-1" />
            </a>
          </h2>
          
          <p class="text-sm text-gray-500 dark:text-gray-400 max-w-sm">
            {site.description}
          </p>
          
          <div class="flex items-center gap-4 mt-2">
            {socialLinks.map((item) => (
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class={`text-gray-400 transition-all duration-200 ease-out hover:-translate-y-1 hover:scale-110 ${item.hoverColor}`}
              >
                <item.icon size={28} />
              </a>
            ))}
            
            <div class="w-px h-6 bg-gray-300 dark:bg-gray-700 mx-1"></div>
            
            <a 
              href={`mailto:contactpabitrams@gmail.com`} 
              class="group inline-flex items-center gap-2 px-5 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 rounded-full shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:scale-105 hover:bg-gray-200 hover:shadow-md dark:hover:bg-gray-700 active:translate-y-0 active:scale-95"
            >
              <FiMail size={16} className="transition-transform duration-200 group-hover:translate-x-0.5" /> 
              Contact Me
            </a>
          </div>
        </div>
      </div>

      <div class="flex flex-col items-center md:items-end text-center md:text-right gap-3 w-full md:w-auto">
        <h3 class="text-xs font-bold text-gray-900 dark:text-white uppercase tracking-wider">
          Support
        </h3>
        
        <p class="text-sm text-gray-500 dark:text-gray-400 max-w-xs">
          Your support keeps these tools free, private, and ad-free.
        </p>
        
        <a
          href={sponsor.page}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-2 inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-full text-sm font-semibold text-gray-700 dark:text-gray-200 shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:scale-105 hover:border-gray-400 hover:shadow-md active:translate-y-0 active:scale-95"
        >
          <FiHeart size={18} className="text-gray-400 transition-colors duration-200 group-hover:text-red-500 group-hover:fill-red-500" />
          Support My Work
        </a>
      </div>

    </div>

    <div class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400 dark:text-gray-500">
        © {currentYear} {site.author}. All rights reserved.
      </p>
      
      <div class="flex items-center gap-6 text-sm text-gray-400 dark:text-gray-500">
        <a href="/contact" class="transition-colors hover:text-gray-900 dark:hover:text-white">Contact</a>
        <a href="/privacy" class="transition-colors hover:text-gray-900 dark:hover:text-white">Privacy Policy</a>
        <a href="/terms" class="transition-colors hover:text-gray-900 dark:hover:text-white">Terms of Service</a>
      </div>
    </div>
  </Container>
</footer>