---
import ThemeToggle from '../../shared/components/ThemeToggle.tsx';
import Container from '../../shared/components/Container.astro';
---
<header class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
  <Container class="py-3 flex items-center justify-between">
    <a href="/" class="font-medium text-lg tracking-tight text-gray-800 dark:text-gray-100 hover:opacity-80 transition-opacity">
      Toolkit
    </a>
    <div class="flex items-center gap-4">
      <a href="https://pabitramohansingh.com" class="text-sm text-gray-600 dark:text-gray-400 hover:text-blue-500 transition-colors">
        Portfolio
      </a>
      <ThemeToggle client:load />
    </div>
  </Container>
</header>