---
import ThemeToggle from '../../shared/components/ThemeToggle.tsx';
import Container from '../../shared/components/Container.astro';
import { site } from '../../config/site';
---
<header class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
  <Container class="py-3 flex items-center justify-between">
    <a href="/" class="font-bold text-xl tracking-tight text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
      {site.name}
    </a>
    <div class="flex items-center gap-4">
      <ThemeToggle client:load />
    </div>
  </Container>
</header>