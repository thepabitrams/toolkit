---
interface AvatarProperties {
  altText?: string;
}

const { altText = "Pabitra Mohan Singh" } = Astro.props;
---
<div class="relative flex h-32 w-32 items-center justify-center">
  <style>
    .avatar-viewport {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 9999px;
      overflow: hidden;
    }

    .avatar-layer {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0;
      animation: avatarCrossfade 8s infinite ease-in-out;
    }

    .avatar-layer:nth-child(1) {
      animation-delay: 0s;
    }

    .avatar-layer:nth-child(2) {
      animation-delay: -4s;
    }

    @keyframes avatarCrossfade {
      0% { opacity: 0; transform: scale(0.95); }
      15%, 45% { opacity: 1; transform: scale(1); }
      55%, 100% { opacity: 0; transform: scale(1.05); }
    }
  </style>

  <div class="avatar-viewport block dark:hidden">
    <img src="/icons/pabitra-avatar-black.svg" alt={altText} class="avatar-layer" />
    <img src="/icons/pabitra-avatar-suit-black.svg" alt={altText} class="avatar-layer" />
  </div>

  <div class="avatar-viewport hidden dark:block">
    <img src="/icons/pabitra-avatar-white.svg" alt={altText} class="avatar-layer" />
    <img src="/icons/pabitra-avatar-suit-white.svg" alt={altText} class="avatar-layer" />
  </div>
</div>