---
import Container from '../../shared/components/Container.astro';
---
<footer class="py-6 border-t border-gray-200 dark:border-gray-800 mt-auto bg-transparent">
  <Container>
    <div class="flex flex-col items-center justify-center gap-3">
      <p class="text-center text-sm text-gray-400 dark:text-gray-500">
        © {new Date().getFullYear()} Toolkit by Pabitra Mohan Singh. Built with ❤️
      </p>
      <div class="flex items-center gap-4 text-sm text-gray-400">
        <a href="https://github.com/thepabitrams" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
          GitHub
        </a>
        <a href="https://www.instagram.com/learnpabitrams" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
          Instagram
        </a>
      </div>
    </div>
  </Container>
</footer>