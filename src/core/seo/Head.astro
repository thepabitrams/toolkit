---
// src/components/Head.astro
import { site, social } from '@/config/site';

export interface BreadcrumbItem {
  readonly name: string;
  readonly url: string;
}

export interface HeadProps {
  title: string;
  description?: string;
  openGraphImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  breadcrumbItems?: readonly BreadcrumbItem[];
}

const {
  title: requestedPageTitle,
  description: requestedPageDescription = site.description,
  openGraphImage: requestedOpenGraphImage = site.openGraphImage,
  canonicalUrl: requestedCanonicalUrl = Astro.url.href,
  noindex: requestedNoIndexStatus = false,
  breadcrumbItems: requestedBreadcrumbItems = [],
} = Astro.props;

const cleanWebPageName = requestedPageTitle.split(' - ')[0];
const personSchemaIdentifier = `${site.domain}/#person`;
const webSiteSchemaIdentifier = `${site.domain}/#website`;
const webPageSchemaIdentifier = `${requestedCanonicalUrl.replace(/\/$/, '')}/#webpage`;

const personSchema = {
  '@type': 'Person',
  '@id': personSchemaIdentifier,
  name: site.author,
  url: site.domain,
  image: site.openGraphImage,
  jobTitle: site.jobTitle,
  sameAs: Object.values(social),
  worksFor: {
    '@type': 'Organization',
    name: site.name,
  },
} as const;

const webSiteSchema = {
  '@type': 'WebSite',
  '@id': webSiteSchemaIdentifier,
  name: site.name,
  url: site.domain,
  description: site.description,
  publisher: { '@id': personSchemaIdentifier },
} as const;

const webPageSchema = {
  '@type': 'WebPage',
  '@id': webPageSchemaIdentifier,
  name: cleanWebPageName,
  description: requestedPageDescription,
  url: requestedCanonicalUrl,
  mainEntityOfPage: { '@id': requestedCanonicalUrl },
  dateModified: new Date().toISOString(),
  inLanguage: 'en',
  isPartOf: { '@id': webSiteSchemaIdentifier },
  about: { '@id': personSchemaIdentifier },
} as const;

const webApplicationSchema = {
  '@type': 'WebApplication',
  name: site.name,
  description: site.description,
  url: site.domain,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  }
} as const;

const breadcrumbListSchema =
  requestedBreadcrumbItems.length >= 2
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: requestedBreadcrumbItems.map(
          (breadcrumbItem: BreadcrumbItem, itemIndex: number) => ({
            '@type': 'ListItem',
            position: itemIndex + 1,
            name: breadcrumbItem.name,
            item: breadcrumbItem.url,
          })
        ),
      }
    : null;

const structuredDataGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema,
    webSiteSchema,
    webPageSchema,
    webApplicationSchema,
    ...(breadcrumbListSchema ? [breadcrumbListSchema] : []),
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{requestedPageTitle}</title>
<meta name="description" content={requestedPageDescription} />

{requestedNoIndexStatus ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={requestedPageTitle} />
<meta property="og:description" content={requestedPageDescription} />
<meta property="og:url" content={requestedCanonicalUrl} />
<meta property="og:image" content={requestedOpenGraphImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={requestedPageTitle} />
<meta name="twitter:description" content={requestedPageDescription} />
<meta name="twitter:image" content={requestedOpenGraphImage} />

<link rel="canonical" href={requestedCanonicalUrl} />

<link rel="icon" type="image/svg+xml" href="/icons/pabitra-avatar-black.svg" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href="/icons/pabitra-avatar-white.svg" media="(prefers-color-scheme: dark)" />

<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" />

<link rel="manifest" href="/manifest.webmanifest" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content={site.name} />
<link rel="apple-touch-icon" href="/pwa-192x192.png" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredDataGraph)} />

<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((serviceWorkerRegistrationError) => {
        console.error('Service Worker registration failed:', serviceWorkerRegistrationError);
      });
    });
  }

  let deferredInstallPromptEvent = null;
  
  window.addEventListener('beforeinstallprompt', (beforeInstallPromptEvent) => {
    beforeInstallPromptEvent.preventDefault();
    deferredInstallPromptEvent = beforeInstallPromptEvent;
    window.dispatchEvent(new CustomEvent('pwa-installable'));
  });

  window.triggerPwaInstall = async () => {
    if (!deferredInstallPromptEvent) return;
    deferredInstallPromptEvent.prompt();
    const { outcome } = await deferredInstallPromptEvent.userChoice;
    if (outcome === 'accepted') {
      deferredInstallPromptEvent = null;
    }
  };
</script>