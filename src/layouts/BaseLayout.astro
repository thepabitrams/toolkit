---
import '../styles/global.css';
import Header from '../core/components/Header.astro';
import Footer from '../core/components/Footer.astro';

interface SEOProperties {
  pageTitle: string;
  pageDescription: string;
  canonicalPath: string;
  structuredData?: Record<string, unknown>;
}

const { pageTitle, pageDescription, canonicalPath, structuredData } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const AUTHOR_NAME = 'Pabitra Mohan Singh';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} | Toolkit</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content={AUTHOR_NAME} />
    
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- 2026 Standard: Pre-paint Theme Initialization -->
    <script is:inline>
      (function initializeTheme() {
        const persistedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const shouldUseDarkMode = persistedTheme === 'dark' || (!persistedTheme && systemPrefersDark);
        
        document.documentElement.classList.toggle('dark', shouldUseDarkMode);
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>