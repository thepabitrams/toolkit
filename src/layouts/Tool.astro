---
import BaseLayout from './Base.astro';
import { ToolHeader } from '@/core/components/header';
import { HomeFooter } from '@/core/components/footer';
import { astro } from 'astro/fetch';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown>;
  toolName?: string;
}

const { title, description, canonicalPath, jsonLd } = Astro.props;
---
<BaseLayout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <ToolHeader client:load />
  <main class="flex-1">
    <slot />
  </main>
  <HomeFooter />
</BaseLayout>